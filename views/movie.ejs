<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> - Movie House</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #141414;
            color: #ffffff;
            padding: 20px;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 15px;
            color: #aaa;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.2s;
        }
        .back-link:hover {
            color: #fff;
        }
        .movie-title {
            margin-bottom: 15px;
            font-size: 24px;
        }
        .video-player-box {
            background-color: #000;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
            position: relative;
        }
        video, iframe {
            width: 100%;
            height: 450px;
            display: block;
            border: none;
        }
        .player-controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            background-color: #1f1f1f;
            padding: 12px;
        }
        .control-btn {
            background-color: #e50914;
            color: #fff;
            border: none;
            padding: 8px 16px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .control-btn:hover {
            background-color: #b80710;
        }
        .movie-details {
            margin-top: 20px;
            background-color: #1f1f1f;
            padding: 20px;
            border-radius: 8px;
        }
        .movie-details p {
            margin-bottom: 10px;
            font-size: 15px;
        }
        .server-buttons {
            margin-top: 15px;
        }
        .server-btn {
            display: inline-block;
            background-color: #333;
            color: #fff;
            padding: 8px 14px;
            margin-right: 8px;
            margin-bottom: 8px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.2s;
        }
        .server-btn:hover {
            background-color: #555;
        }
        .related-section {
            margin-top: 30px;
        }
        .related-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        .related-card {
            background-color: #1f1f1f;
            border-radius: 6px;
            overflow: hidden;
            text-decoration: none;
            color: white;
            transition: transform 0.2s;
        }
        .related-card:hover {
            transform: scale(1.03);
        }
        .related-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
        .related-card p {
            padding: 8px;
            margin: 0;
            font-size: 13px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="container">
        <a href="/" class="back-link">← Back to Home</a>
        
        <h2 class="movie-title"><%= movie.title %></h2>

        <!-- EJS Helper Functions -->
        <% 
            function getYouTubeEmbedUrl(url) {
                if (!url) return null;
                let regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
                let match = url.match(regExp);
                return (match && match[2].length === 11) ? 'https://www.youtube.com/embed/' + match[2] : null;
            }

            function isGenericEmbed(url) {
                if (!url) return false;
                return url.includes('/e/') || url.includes('/embed/') || url.includes('tpead.net');
            }
            
            // Web Series Support: get default initial URL
            let initialUrl = '';
            if (movie.seasons && movie.seasons.length > 0 && movie.seasons[0].episodes && movie.seasons[0].episodes.length > 0) {
                let firstEp = movie.seasons[0].episodes[0];
                initialUrl = (firstEp.videoLinks && firstEp.videoLinks.length > 0) ? firstEp.videoLinks[0].url : (firstEp.videoUrl || '');
            } else if (movie.videoLinks && movie.videoLinks.length > 0) {
                initialUrl = movie.videoLinks[0].url;
            } else if (movie.videoUrl) {
                initialUrl = movie.videoUrl;
            }

            let initialYouTubeEmbed = getYouTubeEmbedUrl(initialUrl);
            let initialIsEmbed = isGenericEmbed(initialUrl);
            let defaultPoster = 'https://via.placeholder.com/300x400?text=No+Poster';
        %>

        <!-- Main Video Container -->
        <div class="video-player-box">
            <div id="mediaArea">
                <% if (initialYouTubeEmbed) { %>
                    <iframe id="ytPlayer" src="<%= initialYouTubeEmbed %>" allowfullscreen allow="autoplay"></iframe>
                <% } else if (initialIsEmbed) { %>
                    <iframe id="embedPlayer" src="<%= initialUrl %>" allowfullscreen allow="autoplay" scrolling="no"></iframe>
                <% } else { %>
                    <video id="mainVideo" controls poster="<%= movie.poster || defaultPoster %>">
                        <source src="<%= initialUrl %>" type="video/mp4">
                        Your browser does not support the video element.
                    </video>
                <% } %>
            </div>

            <!-- Custom Controls -->
            <div class="player-controls" id="controlsBox" style="<%= (initialYouTubeEmbed || initialIsEmbed) ? 'display: none;' : '' %>">
                <button class="control-btn" onclick="rewind(5)">⏪ 5 Sec</button>
                <button class="control-btn" onclick="forward(5)">5 Sec ⏩</button>
            </div>
        </div>

        <!-- Movie & Series Details -->
        <div class="movie-details">
            <p><strong>Category:</strong> <%= movie.category %></p>
            <p><strong>Views:</strong> <%= movie.views %></p>

            <!-- Web Series Seasons & Episodes Selection -->
            <% if (movie.seasons && movie.seasons.length > 0) { %>
                <div class="server-buttons" style="margin-top: 20px;">
                    <% movie.seasons.forEach((season, sIndex) => { %>
                        <div style="margin-bottom: 15px;">
                            <strong>Season <%= season.seasonNumber || (sIndex + 1) %>:</strong><br><br>
                            <% if (season.episodes && season.episodes.length > 0) { %>
                                <% season.episodes.forEach((ep, eIndex) => { %>
                                    <% 
                                        let epLinks = JSON.stringify(ep.videoLinks || [{ name: 'Server 1', url: ep.videoUrl || '' }]); 
                                    %>
                                    <button class="server-btn" onclick='loadEpisode(<%- epLinks %>)'>
                                        Ep <%= ep.episodeNumber || (eIndex + 1) %>: <%= ep.title || ('Episode ' + (eIndex + 1)) %>
                                    </button>
                                <% }) %>
                            <% } else { %>
                                <p style="font-size: 13px; color: #888;">No episodes found in this season.</p>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% } %>

            <!-- Server Selection (Movie or Active Episode) -->
            <div class="server-buttons" id="serverSelectionBox" style="<%= (movie.videoLinks && movie.videoLinks.length > 1) ? '' : 'display: none;' %>">
                <strong>Select Server:</strong><br><br>
                <div id="serverButtonsContainer">
                    <% if (movie.videoLinks && movie.videoLinks.length > 1) { %>
                        <% movie.videoLinks.forEach((link, index) => { %>
                            <button class="server-btn" onclick="switchVideoServer('<%= link.url %>')">
                                <%= link.name || 'Server ' + (index + 1) %>
                            </button>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Related Content -->
        <% if (typeof relatedMovies !== 'undefined' && relatedMovies.length > 0) { %>
            <div class="related-section">
                <h3>Related Content</h3>
                <div class="related-grid">
                    <% relatedMovies.forEach(rel => { %>
                        <a href="/movie/<%= rel._id %>" class="related-card">
                            <img 
                                src="<%= rel.poster %>" 
                                alt="<%= rel.title %>" 
                                onerror="this.onerror=null; this.src='https://via.placeholder.com/300x400?text=No+Image';"
                            >
                            <p><%= rel.title %></p>
                        </a>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Dynamic Switching Scripts -->
    <script>
        function parseYouTubeUrl(url) {
            if (!url) return null;
            let regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            let match = url.match(regExp);
            return (match && match[2].length === 11) ? match[2] : null;
        }

        function switchVideoServer(url) {
            if (!url) return;
            const mediaArea = document.getElementById('mediaArea');
            const controlsBox = document.getElementById('controlsBox');
            
            const ytId = parseYouTubeUrl(url);
            const isEmbedLink = url.includes('/e/') || url.includes('/embed/') || url.includes('tpead.net');

            if (ytId) {
                mediaArea.innerHTML = `<iframe id="ytPlayer" src="https://www.youtube.com/embed/${ytId}?autoplay=1" allowfullscreen allow="autoplay"></iframe>`;
                if (controlsBox) controlsBox.style.display = 'none';
            } else if (isEmbedLink) {
                mediaArea.innerHTML = `<iframe id="embedPlayer" src="${url}" allowfullscreen allow="autoplay" scrolling="no"></iframe>`;
                if (controlsBox) controlsBox.style.display = 'none';
            } else {
                mediaArea.innerHTML = `
                    <video id="mainVideo" controls autoplay poster="<%= movie.poster || 'https://via.placeholder.com/300x400?text=No+Poster' %>">
                        <source src="${url}" type="video/mp4">
                        Your browser does not support the video element.
                    </video>
                `;
                if (controlsBox) controlsBox.style.display = 'flex';
            }
        }

        function loadEpisode(links) {
            if (!links || links.length === 0) return;
            
            // 1. Play first server of episode
            switchVideoServer(links[0].url);

            // 2. Render multi-server buttons for episode (if available)
            const serverBox = document.getElementById('serverSelectionBox');
            const container = document.getElementById('serverButtonsContainer');

            if (links.length > 1) {
                container.innerHTML = '';
                links.forEach((link, idx) => {
                    const btn = document.createElement('button');
                    btn.className = 'server-btn';
                    btn.innerText = link.name || ('Server ' + (idx + 1));
                    btn.onclick = () => switchVideoServer(link.url);
                    container.appendChild(btn);
                });
                serverBox.style.display = 'block';
            } else {
                serverBox.style.display = 'none';
            }
        }

        function rewind(seconds = 5) {
            const video = document.getElementById('mainVideo');
            if (video) {
                video.currentTime = Math.max(0, video.currentTime - seconds);
            }
        }

        function forward(seconds = 5) {
            const video = document.getElementById('mainVideo');
            if (video) {
                const maxTime = isNaN(video.duration) ? video.currentTime + seconds : video.duration;
                video.currentTime = Math.min(maxTime, video.currentTime + seconds);
            }
        }

        window.addEventListener('keydown', function (e) {
            const video = document.getElementById('mainVideo');
            if (!video) return;

            const activeTag = document.activeElement.tagName;
            if (activeTag === 'INPUT' || activeTag === 'TEXTAREA') return;

            if (e.key === 'ArrowLeft' || e.keyCode === 37) {
                e.preventDefault();
                rewind(5);
            } else if (e.key === 'ArrowRight' || e.keyCode === 39) {
                e.preventDefault();
                forward(5);
            }
        }, true);
    </script>
</body>
</html>
