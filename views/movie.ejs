<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %></title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #0f172a; color: #fff; margin: 0; padding: 20px; }
        .container { max-width: 900px; margin: 0 auto; }
        .player-container { background: #1e293b; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
        
        .video-box { width: 100%; height: 450px; background: #000; border: none; border-radius: 6px; }
        
        .controls { text-align: center; margin-top: 10px; }
        .btn-ctrl { background: #ef4444; color: #fff; border: none; padding: 8px 15px; border-radius: 4px; font-weight: bold; cursor: pointer; margin: 0 5px; }

        .details-card { background: #1e293b; padding: 20px; border-radius: 8px; margin-bottom: 20px; }
        
        /* Episode & Server Buttons Style */
        .list-section { background: #1e293b; padding: 20px; border-radius: 8px; margin-bottom: 20px; }
        .list-title { color: #10b981; font-size: 16px; margin-bottom: 12px; }
        .btn-list { display: flex; gap: 10px; flex-wrap: wrap; }
        .btn-item { background: #334155; color: #fff; border: 1px solid #475569; padding: 8px 14px; border-radius: 6px; cursor: pointer; font-size: 14px; transition: 0.2s; }
        .btn-item:hover, .btn-item.active { background: #10b981; border-color: #10b981; color: #fff; }
    </style>
</head>
<body>

<div class="container">
    <h2><%= movie.title %></h2>

    <!-- Video Player Box -->
    <div class="player-container">
        <% 
            let defaultSrc = '';
            if (movie.contentType === 'series' && movie.episodes && movie.episodes.length > 0) {
                defaultSrc = movie.episodes[0].url;
            } else if (movie.videoLinks && movie.videoLinks.length > 0) {
                defaultSrc = movie.videoLinks[0].url;
            }
        %>
        
        <!-- Video Player Frame -->
        <iframe id="videoPlayer" class="video-box" src="<%= defaultSrc %>" allowfullscreen></iframe>

        <div class="controls">
            <button class="btn-ctrl" onclick="seek(-5)">⏪ 5 Sec</button>
            <button class="btn-ctrl" onclick="seek(5)">5 Sec ⏩</button>
        </div>
    </div>

    <!-- Web Series Episodes / Movie Servers List -->
    <div class="list-section">
        <% if (movie.contentType === 'series' && movie.episodes && movie.episodes.length > 0) { %>
            <div class="list-title">📺 Select Episode:</div>
            <div class="btn-list">
                <% movie.episodes.forEach((ep, idx) => { %>
                    <button class="btn-item <%= idx === 0 ? 'active' : '' %>" onclick="changeVideo(this, '<%= ep.url %>')">
                        S<%= ep.season %> E<%= ep.episodeNumber %>: <%= ep.name %>
                    </button>
                <% }) %>
            </div>
        <% } else if (movie.videoLinks && movie.videoLinks.length > 0) { %>
            <div class="list-title">🎥 Select Server:</div>
            <div class="btn-list">
                <% movie.videoLinks.forEach((link, idx) => { %>
                    <button class="btn-item <%= idx === 0 ? 'active' : '' %>" onclick="changeVideo(this, '<%= link.url %>')">
                        <%= link.name %>
                    </button>
                <% }) %>
            </div>
        <% } else { %>
            <p style="color: #94a3b8;">No video streams/episodes available.</p>
        <% } %>
    </div>

    <!-- Movie Details -->
    <div class="details-card">
        <p><strong>Category:</strong> <%= movie.category %></p>
        <p><strong>Views:</strong> <%= movie.views %></p>
    </div>
</div>

<script>
    function changeVideo(button, url) {
        document.getElementById('videoPlayer').src = url;
        
        // Active Class Toggle
        document.querySelectorAll('.btn-item').forEach(b => b.classList.remove('active'));
        button.classList.add('active');
    }

    function seek(seconds) {
        // Simple Iframe seek notification
        const iframe = document.getElementById('videoPlayer');
        alert("Seeking inside iframe is controlled by the external video provider.");
    }
</script>

</body>
</html>
