<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> - MovieHouse</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>

    <!-- Header / Navbar -->
    <header class="navbar">
        <div class="logo">
            <a href="/">🎬 MovieHouse</a>
        </div>
        <form action="/search" method="GET" class="search-form">
            <input type="text" name="q" placeholder="মুভি বা সিরিজ খুঁজুন..." required>
            <button type="submit"><i class="fas fa-search"></i></button>
        </form>
    </header>

    <div class="container main-content">
        <div class="movie-details-wrapper">
            
            <!-- Movie Title -->
            <h1 class="movie-title"><%= movie.title %></h1>
            <div class="movie-meta">
                <span><i class="fas fa-folder"></i> <%= movie.category %></span>
                <span><i class="fas fa-eye"></i> <%= movie.views %> Views</span>
                <span><i class="fas fa-calendar-alt"></i> <%= new Date(movie.createdAt).toLocaleDateString() %></span>
            </div>

            <!-- Main Player Section (All Video & Embed Link Support) -->
            <div class="player-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; background: #000; border-radius: 8px; margin-bottom: 20px;">
                <% 
                    let initialUrl = '';
                    if (movie.videoLinks && movie.videoLinks.length > 0) {
                        initialUrl = movie.videoLinks[0].url;
                    } else if (movie.episodes && movie.episodes.length > 0) {
                        initialUrl = movie.episodes[0].url;
                    }
                %>
                <iframe 
                    id="main-player" 
                    src="<%= initialUrl %>" 
                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" 
                    allowfullscreen 
                    scrolling="no"
                    allow="autoplay; encrypted-media; picture-in-picture; accelerometer; clipboard-write; gyroscope">
                </iframe>
            </div>

            <!-- Server / Source Links (Movie Video Links) -->
            <% if (movie.videoLinks && movie.videoLinks.length > 1) { %>
                <div class="server-selection-box" style="margin-bottom: 25px;">
                    <h3><i class="fas fa-server"></i> Select Server:</h3>
                    <div class="server-buttons" style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px;">
                        <% movie.videoLinks.forEach((link, index) => { %>
                            <button 
                                class="btn-server <%= index === 0 ? 'active' : '' %>" 
                                onclick="changePlayerSource('<%= link.url %>', this)">
                                <i class="fas fa-play-circle"></i> <%= link.name || ('Server ' + (index + 1)) %>
                            </button>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <!-- Web Series Episodes Section -->
            <% if (movie.episodes && movie.episodes.length > 0) { %>
                <div class="episodes-container-box" style="margin-bottom: 30px; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px;">
                    <h3 style="margin-bottom: 15px;"><i class="fas fa-list-ul"></i> Episodes & Seasons:</h3>
                    
                    <div class="episodes-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px;">
                        <% movie.episodes.forEach((ep, index) => { %>
                            <button 
                                class="btn-episode <%= index === 0 ? 'active' : '' %>" 
                                onclick="changePlayerSource('<%= ep.url %>', this)"
                                style="padding: 10px; border: 1px solid rgba(255,255,255,0.2); background: #1f1f1f; color: #fff; border-radius: 5px; cursor: pointer; text-align: left;">
                                <strong>S<%= ep.season || 1 %> E<%= ep.episodeNumber || (index + 1) %></strong>
                                <div style="font-size: 12px; opacity: 0.8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <%= ep.title || ('Episode ' + (index + 1)) %>
                                </div>
                            </button>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <!-- Movie Poster & Details Info -->
            <div class="details-grid" style="display: flex; gap: 20px; margin-top: 20px; flex-wrap: wrap;">
                <div class="poster-box" style="max-width: 250px; flex: 1;">
                    <img src="<%= movie.poster %>" alt="<%= movie.title %>" style="width: 100%; border-radius: 8px;">
                </div>
                <div class="info-box" style="flex: 2; min-width: 280px;">
                    <h2><%= movie.title %></h2>
                    <p>Category: <strong><%= movie.category %></strong></p>
                    <p>Total Views: <strong><%= movie.views %></strong></p>
                </div>
            </div>

            <!-- Related Movies Section -->
            <% if (relatedMovies && relatedMovies.length > 0) { %>
                <div class="related-movies-section" style="margin-top: 40px;">
                    <h3><i class="fas fa-film"></i> Related Content</h3>
                    <div class="movie-grid">
                        <% relatedMovies.forEach(rel => { %>
                            <a href="/movie/<%= rel._id %>" class="movie-card">
                                <img src="<%= rel.poster %>" alt="<%= rel.title %>">
                                <div class="card-info">
                                    <h4><%= rel.title %></h4>
                                </div>
                            </a>
                        <% }) %>
                    </div>
                </div>
            <% } %>

        </div>
    </div>

    <!-- Dynamic Player Switch Script -->
    <script>
        function changePlayerSource(videoUrl, element) {
            const player = document.getElementById('main-player');
            if (player && videoUrl) {
                player.src = videoUrl;
            }
            
            // Active class toggle for buttons
            const parent = element.parentElement;
            if (parent) {
                const siblings = parent.querySelectorAll('button');
                siblings.forEach(btn => btn.classList.remove('active'));
            }
            element.classList.add('active');
        }
    </script>
</body>
</html>
