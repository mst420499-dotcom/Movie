<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: #121212; 
            color: #ffffff; 
            padding: 20px 15px; 
        }

        .container { max-width: 900px; margin: 0 auto; }

        .back-link { 
            display: inline-block; 
            color: #94a3b8; 
            text-decoration: none; 
            font-size: 14px; 
            margin-bottom: 20px; 
        }

        .movie-title { 
            font-size: 22px; 
            font-weight: 700; 
            margin-bottom: 15px; 
        }

        /* Player Container */
        .player-card { 
            background: #1e1e1e; 
            border-radius: 8px; 
            overflow: hidden; 
            margin-bottom: 25px; 
        }
        
        .video-wrapper { 
            position: relative; 
            padding-bottom: 56.25%; 
            height: 0; 
            background: #000; 
        }
        .video-wrapper iframe, .video-wrapper video { 
            position: absolute; 
            top: 0; 
            left: 0; 
            width: 100%; 
            height: 100%; 
            border: 0; 
            object-fit: contain;
        }

        /* 5 Sec Skip Buttons */
        .controls-bar { 
            display: flex; 
            justify-content: center; 
            gap: 10px; 
            padding: 12px; 
            background: #1e1e1e; 
        }
        .btn-skip { 
            background: #e50914; 
            color: #ffffff; 
            border: none; 
            padding: 6px 14px; 
            border-radius: 4px; 
            font-size: 13px; 
            font-weight: bold; 
            cursor: pointer; 
        }
        .btn-skip:hover { background: #b80710; }

        /* Details Card */
        .details-card { 
            background: #1e1e1e; 
            padding: 20px; 
            border-radius: 8px; 
            margin-bottom: 25px; 
        }
        .details-card p { margin-bottom: 8px; font-size: 15px; color: #e2e8f0; }

        .server-title { 
            font-size: 15px; 
            font-weight: bold; 
            margin-top: 15px; 
            margin-bottom: 10px; 
        }

        .btn-group { display: flex; gap: 8px; flex-wrap: wrap; }
        .btn-server { 
            background: #2d3748; 
            color: #ffffff; 
            border: 1px solid #4a5568; 
            padding: 6px 14px; 
            border-radius: 4px; 
            cursor: pointer; 
            font-size: 13px; 
        }
        .btn-server.active { 
            background: #4a5568; 
            border-color: #718096; 
        }

        /* Related Movies Grid */
        .section-title { font-size: 18px; font-weight: bold; margin-bottom: 15px; }
        .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 15px; }
        .movie-card { background: #1e1e1e; border-radius: 6px; overflow: hidden; text-decoration: none; color: #fff; display: block; }
        .movie-card img { width: 100%; height: 180px; object-fit: cover; display: block; }
        .movie-card .info { padding: 8px; font-size: 12px; line-height: 1.3; }
    </style>
</head>
<body>

<div class="container">
    <a href="/" class="back-link">← Back to Home</a>

    <h1 class="movie-title"><%= movie.title %></h1>

    <!-- Player Area -->
    <div class="player-card">
        <div class="video-wrapper" id="playerContainer">
            <!-- Dynamic Video Loaded Here -->
        </div>
        
        <div class="controls-bar">
            <button class="btn-skip" onclick="skipTime(-5)">⏪ 5 Sec</button>
            <button class="btn-skip" onclick="skipTime(5)">5 Sec ⏩</button>
        </div>
    </div>

    <!-- Info Card -->
    <div class="details-card">
        <p><strong>Category:</strong> <%= movie.category %></p>
        <p><strong>Views:</strong> <%= movie.views %></p>

        <% if (movie.contentType === 'series' && movie.episodes && movie.episodes.length > 0) { %>
            <div class="server-title">Select Episode:</div>
            <div class="btn-group">
                <% movie.episodes.forEach((ep, idx) => { %>
                    <button class="btn-server <%= idx === 0 ? 'active' : '' %>" onclick="playMedia(this, '<%= ep.url %>')">
                        S<%= ep.season %> E<%= ep.episodeNumber %>: <%= ep.name %>
                    </button>
                <% }) %>
            </div>
        <% } else if (movie.videoLinks && movie.videoLinks.length > 0) { %>
            <div class="server-title">Select Server:</div>
            <div class="btn-group">
                <% movie.videoLinks.forEach((link, idx) => { %>
                    <button class="btn-server <%= idx === 0 ? 'active' : '' %>" onclick="playMedia(this, '<%= link.url %>')">
                        <%= link.name %>
                    </button>
                <% }) %>
            </div>
        <% } %>
    </div>

    <!-- Related Movies Grid -->
    <% if (typeof relatedMovies !== 'undefined' && relatedMovies.length > 0) { %>
        <h3 class="section-title">Related Movies</h3>
        <div class="related-grid">
            <% relatedMovies.forEach(rel => { %>
                <a href="/movie/<%= rel._id %>" class="movie-card">
                    <img src="<%= rel.poster %>" alt="<%= rel.title %>">
                    <div class="info"><strong><%= rel.title %></strong></div>
                </a>
            <% }) %>
        </div>
    <% } %>
</div>

<script>
    let isDirectVideo = false;

    function playMedia(btn, url) {
        const container = document.getElementById('playerContainer');
        const cleanUrl = url.trim();

        // ১. Direct MP4/Local File Check
        if (cleanUrl.match(/\.(mp4|webm|mkv|ogg)($|\?)/i) || cleanUrl.startsWith('/uploads/')) {
            isDirectVideo = true;
            container.innerHTML = `<video id="videoPlayer" controls autoplay tabindex="0" style="width:100%; height:100%;">
                <source src="${cleanUrl}">
            </video>`;
            
            // অটো প্লেয়ার ফোকাস করা
            setTimeout(() => {
                const vid = document.getElementById('videoPlayer');
                if (vid) vid.focus();
            }, 300);

        } else {
            // ২. Embed / YouTube Link Check
            isDirectVideo = false;
            let embedUrl = cleanUrl;
            
            // Enable JS API for YouTube
            if (cleanUrl.includes('youtube.com/watch?v=')) {
                const videoId = cleanUrl.split('v=')[1].split('&')[0];
                embedUrl = 'https://www.youtube.com/embed/' + videoId + '?enablejsapi=1&autoplay=1';
            } else if (cleanUrl.includes('youtu.be/')) {
                const videoId = cleanUrl.split('youtu.be/')[1].split('?')[0];
                embedUrl = 'https://www.youtube.com/embed/' + videoId + '?enablejsapi=1&autoplay=1';
            }

            container.innerHTML = `<iframe id="videoPlayer" tabindex="0" src="${embedUrl}" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>`;
            
            // আইফ্রেমে কীবোর্ড ফোকাস সেট করা
            setTimeout(() => {
                const frame = document.getElementById('videoPlayer');
                if (frame) frame.focus();
            }, 500);
        }

        // Active Button UI Update
        document.querySelectorAll('.btn-server').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
    }

    // ৫ সেকেন্ড স্কিপ ফাংশন (বাটন ক্লিকের জন্য)
    function skipTime(seconds) {
        if (isDirectVideo) {
            const video = document.getElementById('videoPlayer');
            if (video) video.currentTime += seconds;
        } else {
            // YouTube / Embed-এর ফোকাস আইফ্রেমে দিয়ে কীবোর্ড ইভেন্ট পাঠানো
            const frame = document.getElementById('videoPlayer');
            if (frame) {
                frame.focus();
                alert("Embedded প্লেয়ারের ক্ষেত্রে কীবোর্ডের (← / →) অ্যারো কি ব্যবহার করুন।");
            }
        }
    }

    // 🟢 কীবোর্ড শটকার্ট হ্যান্ডলার (Arrow Left & Arrow Right)
    document.addEventListener('keydown', function(e) {
        if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
            
            // Direct Video (.mp4) হলে JavaScript দিয়ে স্কিপ হবে
            if (isDirectVideo) {
                e.preventDefault(); // পেজ স্ক্রোল বন্ধ রাখা
                const video = document.getElementById('videoPlayer');
                if (video) {
                    if (e.key === "ArrowLeft") video.currentTime -= 5;
                    if (e.key === "ArrowRight") video.currentTime += 5;
                }
            } else {
                // Embedded/YouTube প্লেয়ার হলে সরাসরি ফোকাস ধরে রাখবে
                const frame = document.getElementById('videoPlayer');
                if (frame && document.activeElement !== frame) {
                    frame.focus();
                }
            }
        }
    });

    // অটো ফার্স্ট প্লেয়ার লোড
    document.addEventListener("DOMContentLoaded", function() {
        const firstBtn = document.querySelector('.btn-server');
        if (firstBtn) firstBtn.click();
    });
</script>

</body>
</html>
