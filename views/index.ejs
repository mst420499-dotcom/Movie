<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MOVIEHOUSE - Stream Movies</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #0b0e14;
            color: #ffffff;
            padding: 20px;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0 20px 0;
        }
        .search-box {
            display: flex;
            justify-content: center;
            margin: 20px 0;
        }
        .search-box input {
            width: 50%;
            padding: 10px 15px;
            border-radius: 20px 0 0 20px;
            border: none;
            background-color: #161b26;
            color: #fff;
            outline: none;
        }
        .search-box button {
            padding: 10px 20px;
            border-radius: 0 20px 20px 0;
            border: none;
            background-color: #00bcd4;
            color: #fff;
            font-weight: bold;
            cursor: pointer;
        }
        .categories {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 30px;
        }
        .category-btn {
            background-color: #161b26;
            color: #aaa;
            border: none;
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
        }
        .category-btn.active {
            background-color: #00bcd4;
            color: #fff;
        }
        .section-title {
            text-align: center;
            font-size: 18px;
            letter-spacing: 1px;
            margin: 30px 0 15px 0;
            text-transform: uppercase;
        }
        .movie-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .movie-card {
            background-color: #121824;
            border-radius: 8px;
            overflow: hidden;
            text-decoration: none;
            color: #fff;
            position: relative;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s;
        }
        .movie-card:hover {
            transform: translateY(-5px);
        }
        .poster-container {
            width: 100%;
            height: 250px;
            background-color: #1a2232;
            position: relative;
        }
        .poster-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .views-badge {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background-color: rgba(0, 0, 0, 0.7);
            font-size: 11px;
            padding: 3px 8px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .movie-info {
            padding: 12px;
            text-align: center;
            margin-top: auto;
        }
        .movie-info h4 {
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    </style>
</head>
<body>

    <!-- Search Section -->
    <form action="/" method="GET" class="search-box">
        <input type="text" name="search" placeholder="Search movies..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        <button type="submit">Search</button>
    </form>

    <!-- Category Filters -->
    <div class="categories">
        <a href="/" class="category-btn <%= !selectedCategory ? 'active' : '' %>">All Movies</a>
        <% if (typeof categories !== 'undefined') { %>
            <% categories.forEach(cat => { %>
                <a href="/?category=<%= cat %>" class="category-btn <%= selectedCategory === cat ? 'active' : '' %>"><%= cat %></a>
            <% }) %>
        <% } %>
    </div>

    <!-- Recently Updated Section -->
    <h3 class="section-title">RECENTLY UPDATED</h3>
    <div class="movie-grid">
        <% if (typeof movies !== 'undefined' && movies.length > 0) { %>
            <% movies.forEach(movie => { %>
                <a href="/movie/<%= movie._id %>" class="movie-card">
                    <div class="poster-container">
                        <img 
                            src="<%= movie.poster %>" 
                            alt="<%= movie.title %>"
                            onerror="this.onerror=null; this.src='https://via.placeholder.com/300x400?text=No+Image';"
                        >
                        <span class="views-badge">👁 <%= movie.views || 0 %></span>
                    </div>
                    <div class="movie-info">
                        <h4><%= movie.title %></h4>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <p style="grid-column: 1/-1; text-align: center; color: #aaa;">No movies found.</p>
        <% } %>
    </div>

    <!-- Popular Movies Section -->
    <% if (typeof popularMovies !== 'undefined' && popularMovies.length > 0) { %>
        <h3 class="section-title">POPULAR MOVIES</h3>
        <div class="movie-grid">
            <% popularMovies.forEach(movie => { %>
                <a href="/movie/<%= movie._id %>" class="movie-card">
                    <div class="poster-container">
                        <img 
                            src="<%= movie.poster %>" 
                            alt="<%= movie.title %>"
                            onerror="this.onerror=null; this.src='https://via.placeholder.com/300x400?text=No+Image';"
                        >
                        <span class="views-badge">👁 <%= movie.views || 0 %></span>
                    </div>
                    <div class="movie-info">
                        <h4><%= movie.title %></h4>
                    </div>
                </a>
            <% }) %>
        </div>
    <% } %>

</body>
</html>
