<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MOVIEHOUSE - Stream Movies</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #0d111a;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Top Header */
        .top-header {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            padding: 20px;
            width: 100%;
        }
        .logo {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 1px;
            color: #ffffff;
            text-decoration: none;
        }
        .logo span {
            color: #00bfa5;
        }
        .user-badge {
            position: absolute;
            right: 40px;
            top: 20px;
            width: 35px;
            height: 35px;
            background-color: #d97706;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 0 10px rgba(217, 119, 6, 0.4);
        }

        .main-content {
            flex: 1;
            max-width: 1250px;
            width: 100%;
            margin: 0 auto;
            padding: 10px 20px 40px 20px;
        }

        /* Search Bar */
        .search-container {
            display: flex;
            justify-content: center;
            margin-bottom: 25px;
        }
        .search-form {
            display: flex;
            width: 100%;
            max-width: 480px;
            background-color: #171d2a;
            border-radius: 30px;
            padding: 4px;
        }
        .search-form input {
            flex: 1;
            background: transparent;
            border: none;
            padding: 10px 20px;
            color: #8b9bb4;
            outline: none;
            font-size: 14px;
        }
        .search-form input::placeholder {
            color: #55657e;
        }
        .search-form button {
            background-color: #00bfa5;
            color: #ffffff;
            border: none;
            padding: 10px 25px;
            border-radius: 25px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .search-form button:hover {
            opacity: 0.9;
        }

        /* Categories Bar */
        .categories-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 40px;
        }
        .cat-pill {
            background-color: #171d2a;
            color: #9aa8bc;
            text-decoration: none;
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s;
        }
        .cat-pill:hover {
            color: #ffffff;
            background-color: #1f2738;
        }
        .cat-pill.active {
            background-color: #00bfa5;
            color: #ffffff;
            font-weight: 600;
        }

        /* Section Title */
        .section-title {
            text-align: center;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 1px;
            color: #ffffff;
            margin: 30px 0 20px 0;
            text-transform: uppercase;
        }

        /* Movie Grid */
        .movie-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        @media (max-width: 1024px) {
            .movie-grid { grid-template-columns: repeat(4, 1fr); }
        }
        @media (max-width: 768px) {
            .movie-grid { grid-template-columns: repeat(2, 1fr); }
            .user-badge { right: 20px; }
        }

        /* Movie Card */
        .movie-card {
            background-color: #171d2a;
            border-radius: 12px;
            overflow: hidden;
            text-decoration: none;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .movie-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }

        .poster-wrapper {
            position: relative;
            width: 100%;
            padding-top: 130%;
            background-color: #000000;
            overflow: hidden;
        }
        .poster-wrapper img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .view-badge {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background-color: rgba(0, 0, 0, 0.75);
            color: #ffffff;
            font-size: 11px;
            padding: 3px 8px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 4px;
            backdrop-filter: blur(2px);
        }

        .card-footer {
            padding: 14px 10px;
            text-align: center;
            background-color: #171d2a;
            margin-top: auto;
        }
        .card-title {
            font-size: 13px;
            font-weight: 600;
            color: #ffffff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.4;
        }

        /* Pagination Styles */
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin: 30px 0;
        }
        .page-btn {
            padding: 8px 20px;
            background-color: #00bfa5;
            color: #ffffff;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 700;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            transition: background 0.2s;
        }
        .page-btn:hover:not(.disabled) {
            background-color: #009688;
        }
        .page-btn.disabled {
            background-color: #171d2a;
            color: #435269;
            pointer-events: none;
        }
        .page-info {
            font-size: 14px;
            color: #8b9bb4;
        }

        /* Site Footer */
        .site-footer {
            background-color: #090d14;
            text-align: center;
            padding: 20px;
            font-size: 13px;
            color: #6b7a90;
            border-top: 1px solid #141a26;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header class="top-header">
        <a href="/" class="logo">MOVIE<span>HOUSE</span></a>
        <div class="user-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
        </div>
    </header>

    <main class="main-content">
        <!-- Search Form -->
        <div class="search-container">
            <form action="/" method="GET" class="search-form">
                <input type="text" name="search" placeholder="Search movies..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                <button type="submit">Search</button>
            </form>
        </div>

        <!-- Categories List -->
        <div class="categories-wrapper">
            <a href="/?page=1" class="cat-pill <%= (!selectedCategory || selectedCategory === 'All') ? 'active' : '' %>">All Movies</a>
            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                    <a href="/?category=<%= encodeURIComponent(cat) %>&page=1" class="cat-pill <%= selectedCategory === cat ? 'active' : '' %>"><%= cat %></a>
                <% }) %>
            <% } %>
        </div>

        <!-- Recently Updated Section -->
        <h2 class="section-title">RECENTLY UPDATED</h2>
        <div class="movie-grid">
            <% if (typeof movies !== 'undefined' && movies.length > 0) { %>
                <% movies.slice(0, 5).forEach(movie => { %>
                    <a href="/movie/<%= movie._id || movie.id %>" class="movie-card">
                        <div class="poster-wrapper">
                            <img 
                                src="<%= movie.poster %>" 
                                alt="<%= movie.title %>"
                                onerror="this.onerror=null; this.src='https://via.placeholder.com/300x400/000000/FFFFFF?text=No+Image';"
                            >
                            <span class="view-badge">👁 <%= movie.views || 0 %></span>
                        </div>
                        <div class="card-footer">
                            <div class="card-title" title="<%= movie.title %>"><%= movie.title %></div>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <p style="grid-column: 1/-1; text-align: center; color: #8b9bb4; padding: 30px 0;">No movies found.</p>
            <% } %>
        </div>

        <!-- Pagination Controls -->
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <% 
                let queryCategory = (typeof selectedCategory !== 'undefined' && selectedCategory && selectedCategory !== 'All') ? '&category=' + encodeURIComponent(selectedCategory) : '';
                let querySearch = (typeof searchQuery !== 'undefined' && searchQuery) ? '&search=' + encodeURIComponent(searchQuery) : '';
                let extraParams = queryCategory + querySearch;
            %>
            <div class="pagination">
                <a href="/?page=<%= currentPage - 1 %><%= extraParams %>" class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>">← Previous</a>
                
                <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>
                
                <a href="/?page=<%= currentPage + 1 %><%= extraParams %>" class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>">Next →</a>
            </div>
        <% } %>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        © Movie House - All Rights Reserved
    </footer>

</body>
</html>
