<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MOVIEHOUSE - Stream Movies & Series</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: #090d16; 
            color: #ffffff; 
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-wrapper { flex: 1; padding: 20px 15px; }
        .container { max-width: 1200px; margin: 0 auto; }

        /* Top Header & Logo */
        .header {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            margin-bottom: 25px;
        }

        .logo {
            font-size: 26px;
            font-weight: 900;
            color: #ffffff;
            text-decoration: none;
            letter-spacing: 1px;
        }

        .logo span { color: #00bcd4; }

        .theme-toggle {
            position: absolute;
            right: 10px;
            background: #1b2434;
            border: none;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #ffb74d;
            font-size: 18px;
        }

        /* Search Bar */
        .search-container {
            max-width: 550px;
            margin: 0 auto 30px auto;
        }

        .search-box {
            display: flex;
            background: #121926;
            border-radius: 30px;
            padding: 5px 6px 5px 20px;
            border: 1px solid #1e293b;
        }

        .search-input {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            color: #fff;
            font-size: 14px;
        }

        .search-btn {
            background: #00bcd4;
            color: #ffffff;
            border: none;
            padding: 10px 24px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 700;
            font-size: 14px;
            transition: background 0.2s;
        }

        .search-btn:hover { background: #00acc1; }

        /* Category Pill Buttons Navigation */
        .category-nav {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .cat-btn {
            background: #121926;
            color: #94a3b8;
            padding: 8px 18px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid #1e293b;
            transition: all 0.2s;
        }

        .cat-btn:hover, .cat-btn.active {
            background: #00bcd4;
            color: #ffffff;
            border-color: #00bcd4;
        }

        /* Section Title */
        .section-title {
            text-align: center;
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 25px;
            color: #ffffff;
            text-transform: uppercase;
        }

        /* Movie Grid Layout */
        .movie-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); 
            gap: 18px; 
            margin-bottom: 40px;
        }

        .movie-card { 
            background: #121926; 
            border-radius: 12px; 
            overflow: hidden; 
            text-decoration: none; 
            color: #fff; 
            transition: transform 0.2s, box-shadow 0.2s;
            display: flex;
            flex-direction: column;
            border: 1px solid #1e293b;
        }

        .movie-card:hover { 
            transform: translateY(-5px); 
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }

        /* Poster Wrapper */
        .poster-wrapper {
            position: relative;
            width: 100%;
            height: 270px;
            background: #0a0e17;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .poster-wrapper img { 
            width: 100%; 
            height: 100%; 
            object-fit: cover; 
            display: block; 
        }

        /* Play Icon Indicator if Poster Image Fails */
        .play-placeholder {
            font-size: 40px;
            color: #ffffff;
            opacity: 0.8;
        }

        /* Views Badge Overlay */
        .views-badge {
            position: absolute;
            bottom: 8px;
            right: 10px;
            background: rgba(0, 0, 0, 0.7);
            padding: 2px 8px;
            border-radius: 10px;
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .movie-card .info { 
            padding: 14px 10px; 
            font-size: 13px; 
            font-weight: 700;
            text-align: center;
            background: #121926;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Pagination Style (1 2 3 Buttons) */
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-bottom: 50px;
            flex-wrap: wrap;
        }

        .page-btn {
            background: #121926;
            color: #ffffff;
            border: 1px solid #1e293b;
            padding: 8px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 13px;
            font-weight: bold;
            transition: all 0.2s;
        }

        .page-btn:hover, .page-btn.active { 
            background: #00bcd4; 
            border-color: #00bcd4; 
            color: #fff; 
        }

        /* Footer Style */
        .footer {
            background: #060910;
            padding: 20px 0;
            text-align: center;
            border-top: 1px solid #121926;
            color: #64748b;
            font-size: 13px;
        }
    </style>
</head>
<body>

<div class="main-wrapper">
    <div class="container">
        
        <!-- Header -->
        <div class="header">
            <a href="/" class="logo">MOVIE<span>HOUSE</span></a>
            <button class="theme-toggle">☀️</button>
        </div>

        <!-- Search Bar -->
        <div class="search-container">
            <form action="/" method="GET" class="search-box">
                <input type="text" name="search" class="search-input" placeholder="Search movies..." value="<%= searchQuery %>">
                <button type="submit" class="search-btn">Search</button>
            </form>
        </div>

        <% const activeCat = typeof selectedCategory !== 'undefined' ? selectedCategory : null; %>
        
        <!-- Categories Navigation Pill Bar -->
        <div class="category-nav">
            <a href="/" class="cat-btn <%= !activeCat ? 'active' : '' %>">All Movies</a>
            <a href="/category/Bangladeshi" class="cat-btn <%= activeCat === 'Bangladeshi' ? 'active' : '' %>">Bangladeshi</a>
            <a href="/category/Kolkata Bangla" class="cat-btn <%= activeCat === 'Kolkata Bangla' ? 'active' : '' %>">Kolkata Bangla</a>
            <a href="/category/Hindi" class="cat-btn <%= activeCat === 'Hindi' ? 'active' : '' %>">Hindi</a>
            <a href="/category/Tamil" class="cat-btn <%= activeCat === 'Tamil' ? 'active' : '' %>">Tamil</a>
            <a href="/category/English" class="cat-btn <%= activeCat === 'English' ? 'active' : '' %>">English</a>
            <a href="/category/MCU" class="cat-btn <%= activeCat === 'MCU' ? 'active' : '' %>">MCU</a>
            <a href="/category/MCU WEB" class="cat-btn <%= activeCat === 'MCU WEB' ? 'active' : '' %>">MCU WEB</a>
            <a href="/category/DCU" class="cat-btn <%= activeCat === 'DCU' ? 'active' : '' %>">DCU</a>
            <a href="/category/Web Series" class="cat-btn <%= activeCat === 'Web Series' ? 'active' : '' %>">Web Series</a>
            <a href="/category/Natok" class="cat-btn <%= activeCat === 'Natok' ? 'active' : '' %>">Natok</a>
        </div>

        <!-- RECENTLY UPDATED SECTION -->
        <h2 class="section-title">RECENTLY UPDATED</h2>
        <div class="movie-grid">
            <% if (movies && movies.length > 0) { %>
                <% movies.forEach(movie => { %>
                    <a href="/movie/<%= movie._id %>" class="movie-card">
                        <div class="poster-wrapper">
                            <% if(movie.poster) { %>
                                <img src="<%= movie.poster %>" alt="<%= movie.title %>">
                            <% } else { %>
                                <div class="play-placeholder">▶</div>
                            <% } %>
                            <span class="views-badge">👁 <%= movie.views || 0 %></span>
                        </div>
                        <div class="info"><%= movie.title %></div>
                    </a>
                <% }) %>
            <% } else { %>
                <p style="grid-column: 1/-1; text-align: center; color: #64748b;">No movies found.</p>
            <% } %>
        </div>

        <!-- Pagination Bar -->
        <% if (totalPages > 1) { %>
            <% const baseUrl = activeCat ? '/category/' + activeCat : ''; %>
            <div class="pagination">
                <% if (currentPage > 1) { %>
                    <a href="<%= baseUrl %>?page=<%= currentPage - 1 %>" class="page-btn">« Prev</a>
                <% } %>
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="<%= baseUrl %>?page=<%= i %>" class="page-btn <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
                <% } %>
                <% if (currentPage < totalPages) { %>
                    <a href="<%= baseUrl %>?page=<%= currentPage + 1 %>" class="page-btn">Next »</a>
                <% } %>
            </div>
        <% } %>

        <!-- POPULAR MOVIES SECTION -->
        <% if (!activeCat && !searchQuery && popularMovies && popularMovies.length > 0) { %>
            <h2 class="section-title">POPULAR MOVIES</h2>
            <div class="movie-grid">
                <% popularMovies.forEach(movie => { %>
                    <a href="/movie/<%= movie._id %>" class="movie-card">
                        <div class="poster-wrapper">
                            <% if(movie.poster) { %>
                                <img src="<%= movie.poster %>" alt="<%= movie.title %>">
                            <% } else { %>
                                <div class="play-placeholder">▶</div>
                            <% } %>
                            <span class="views-badge">👁 <%= movie.views || 0 %></span>
                        </div>
                        <div class="info"><%= movie.title %></div>
                    </a>
                <% }) %>
            </div>
        <% } %>

    </div>
</div>

<!-- Footer -->
<footer class="footer">
    <p>© MOVIEHOUSE - All Rights Reserved</p>
</footer>

</body>
</html>
