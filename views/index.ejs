<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Streaming Platform</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', sans-serif; background: #0f172a; color: #fff; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; }
        .navbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 10px; }
        .categories { display: flex; gap: 8px; flex-wrap: wrap; }
        .cat-btn { padding: 6px 12px; background: #1e293b; color: #94a3b8; text-decoration: none; border-radius: 6px; font-size: 13px; }
        .cat-btn.active { background: #10b981; color: #fff; font-weight: bold; }
        .movie-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .card { background: #1e293b; border-radius: 8px; overflow: hidden; position: relative; transition: transform 0.2s; }
        .card:hover { transform: translateY(-5px); }
        .card img { width: 100%; height: 260px; object-fit: cover; }
        .card-body { padding: 12px; }
        .card-title { font-size: 15px; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 5px; }
        .card-meta { font-size: 12px; color: #94a3b8; }
        .pin-badge { position: absolute; top: 8px; left: 8px; background: #f59e0b; color: #000; font-size: 10px; font-weight: bold; padding: 3px 6px; border-radius: 4px; }
        
        /* Pagination Styles */
        .pagination { display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 20px; }
        .page-btn { padding: 8px 16px; background: #3b82f6; color: #fff; text-decoration: none; border-radius: 6px; font-weight: bold; font-size: 14px; }
        .page-btn.disabled { background: #334155; color: #64748b; pointer-events: none; }
        .page-info { font-size: 14px; color: #94a3b8; }
    </style>
</head>
<body>

<div class="container">
    <div class="navbar">
        <h2>🎬 Movie Hub</h2>
        <div class="categories">
            <a href="/?page=1" class="cat-btn <%= selectedCategory === 'All' ? 'active' : '' %>">All</a>
            <% categories.forEach(cat => { %>
                <a href="/?category=<%= encodeURIComponent(cat) %>&page=1" class="cat-btn <%= selectedCategory === cat ? 'active' : '' %>"><%= cat %></a>
            <% }) %>
        </div>
    </div>

    <!-- Movies Grid -->
    <div class="movie-grid">
        <% if (movies && movies.length > 0) { %>
            <% movies.forEach(movie => { %>
                <a href="/movie/<%= movie.id %>" style="text-decoration: none; color: inherit;">
                    <div class="card">
                        <% if (movie.isPinned) { %> <span class="pin-badge">PINNED</span> <% } %>
                        <img src="<%= movie.poster %>" alt="<%= movie.title %>">
                        <div class="card-body">
                            <div class="card-title"><%= movie.title %></div>
                            <div class="card-meta"><%= movie.category %></div>
                        </div>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <p style="grid-column: 1/-1; text-align: center; color: #94a3b8;">No movies found.</p>
        <% } %>
    </div>

    <!-- Pagination Controls -->
    <% if (totalPages > 1) { %>
        <div class="pagination">
            <% const catParam = selectedCategory && selectedCategory !== 'All' ? '&category=' + encodeURIComponent(selectedCategory) : ''; %>
            
            <a href="/?page=<%= currentPage - 1 %><%= catParam %>" class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>">← Previous</a>
            
            <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>
            
            <a href="/?page=<%= currentPage + 1 %><%= catParam %>" class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>">Next →</a>
        </div>
    <% } %>
</div>

</body>
</html>
