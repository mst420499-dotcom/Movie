<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Movie Streaming</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: #121212; 
            color: #ffffff; 
            padding: 20px 15px; 
        }

        .container { max-width: 1000px; margin: 0 auto; }

        /* Header & Search Bar */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .logo {
            font-size: 24px;
            font-weight: 800;
            color: #e50914;
            text-decoration: none;
        }

        .search-box {
            display: flex;
            gap: 8px;
        }

        .search-input {
            background: #1e1e1e;
            border: 1px solid #333;
            padding: 8px 12px;
            border-radius: 4px;
            color: #fff;
            outline: none;
            font-size: 14px;
        }

        .search-btn {
            background: #e50914;
            color: #fff;
            border: none;
            padding: 8px 14px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        /* Category Filter Buttons */
        .category-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .cat-btn {
            background: #1e1e1e;
            color: #cbd5e1;
            padding: 6px 14px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 13px;
            white-space: nowrap;
            border: 1px solid #333;
            transition: all 0.2s;
        }

        .cat-btn:hover {
            background: #e50914;
            color: #fff;
            border-color: #e50914;
        }

        .section-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        /* Movie Card Grid Layout */
        .movie-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); 
            gap: 15px; 
        }

        .movie-card { 
            background: #1e1e1e; 
            border-radius: 6px; 
            overflow: hidden; 
            text-decoration: none; 
            color: #fff; 
            transition: transform 0.2s;
            display: block;
        }

        .movie-card:hover { transform: translateY(-4px); }

        .movie-card img { 
            width: 100%; 
            height: 230px; 
            object-fit: cover; 
            display: block; 
        }

        .movie-card .info { 
            padding: 10px; 
            font-size: 13px; 
            font-weight: 600;
            line-height: 1.3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Pagination Style (1 2 3 Buttons) */
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-top: 35px;
            flex-wrap: wrap;
        }

        .page-btn {
            background: #1e1e1e;
            color: #ffffff;
            border: 1px solid #333;
            padding: 8px 14px;
            border-radius: 4px;
            text-decoration: none;
            font-size: 14px;
            font-weight: bold;
            transition: background 0.2s;
        }

        .page-btn:hover { 
            background: #e50914; 
            border-color: #e50914; 
            color: #fff; 
        }

        .page-btn.active { 
            background: #e50914; 
            border-color: #e50914; 
            color: #fff; 
            pointer-events: none; 
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Header Area -->
    <div class="header">
        <a href="/" class="logo">MovieFlix</a>
        <form action="/" method="GET" class="search-box">
            <input type="text" name="search" class="search-input" placeholder="Search content..." required>
            <button type="submit" class="search-btn">Search</button>
        </form>
    </div>

    <!-- Quick Category Menu -->
    <div class="category-nav">
        <a href="/" class="cat-btn">All</a>
        <a href="/category/Natok" class="cat-btn">Natok</a>
        <a href="/category/Movie" class="cat-btn">Movie</a>
        <a href="/category/Web Series" class="cat-btn">Web Series</a>
        <a href="/category/Telefilm" class="cat-btn">Telefilm</a>
    </div>

    <h2 class="section-title">Latest Content</h2>

    <!-- Movie Display Grid -->
    <div class="movie-grid">
        <% if (movies && movies.length > 0) { %>
            <% movies.forEach(movie => { %>
                <a href="/movie/<%= movie._id %>" class="movie-card">
                    <img src="<%= movie.poster %>" alt="<%= movie.title %>">
                    <div class="info"><%= movie.title %></div>
                </a>
            <% }) %>
        <% } else { %>
            <p style="grid-column: 1/-1; text-align: center; color: #94a3b8;">No content found.</p>
        <% } %>
    </div>

    <!-- Pagination Controls (1 2 3) -->
    <% if (totalPages > 1) { %>
        <div class="pagination">
            <% if (currentPage > 1) { %>
                <a href="/?page=<%= currentPage - 1 %>" class="page-btn">« Prev</a>
            <% } %>

            <% for(let i = 1; i <= totalPages; i++) { %>
                <a href="/?page=<%= i %>" class="page-btn <%= currentPage === i ? 'active' : '' %>">
                    <%= i %>
                </a>
            <% } %>

            <% if (currentPage < totalPages) { %>
                <a href="/?page=<%= currentPage + 1 %>" class="page-btn">Next »</a>
            <% } %>
        </div>
    <% } %>
</div>

</body>
</html>
