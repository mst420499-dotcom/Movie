<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MOVIEHOUSE - Stream Movies & Series</title>
    <style>
        /* 🟢 Theme Variables Setup */
        :root {
            --bg-body: #090d16;
            --bg-header: #060910;
            --bg-card: #121926;
            --bg-pill: #121926;
            --text-main: #ffffff;
            --text-sub: #94a3b8;
            --border-color: #1e293b;
            --accent-color: #00bcd4;
        }

        /* 🟢 Light Mode Variables */
        body.light-mode {
            --bg-body: #f1f5f9;
            --bg-header: #ffffff;
            --bg-card: #ffffff;
            --bg-pill: #e2e8f0;
            --text-main: #0f172a;
            --text-sub: #475569;
            --border-color: #cbd5e1;
            --accent-color: #00bcd4;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: var(--bg-body); 
            color: var(--text-main); 
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            transition: background 0.3s, color 0.3s;
        }

        .main-wrapper { flex: 1; padding: 20px 15px; }
        .container { max-width: 1200px; margin: 0 auto; }

        /* Top Header & Logo */
        .header {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            margin-bottom: 25px;
        }

        .logo {
            font-size: 26px;
            font-weight: 900;
            color: var(--text-main);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .logo span { color: var(--accent-color); }

        /* Theme Toggle Button */
        .theme-toggle {
            position: absolute;
            right: 10px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 18px;
            transition: all 0.2s;
        }

        .theme-toggle:hover {
            transform: scale(1.05);
        }

        /* Search Bar */
        .search-container {
            max-width: 550px;
            margin: 0 auto 30px auto;
        }

        .search-box {
            display: flex;
            background: var(--bg-card);
            border-radius: 30px;
            padding: 5px 6px 5px 20px;
            border: 1px solid var(--border-color);
        }

        .search-input {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-main);
            font-size: 14px;
        }

        .search-btn {
            background: var(--accent-color);
            color: #ffffff;
            border: none;
            padding: 10px 24px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 700;
            font-size: 14px;
            transition: background 0.2s;
        }

        .search-btn:hover { background: #00acc1; }

        /* Category Navigation Bar */
        .category-nav {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .cat-btn {
            background: var(--bg-pill);
            color: var(--text-sub);
            padding: 8px 18px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid var(--border-color);
            transition: all 0.2s;
        }

        .cat-btn:hover, .cat-btn.active {
            background: var(--accent-color);
            color: #ffffff;
            border-color: var(--accent-color);
        }

        /* Section Title */
        .section-title {
            text-align: center;
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 25px;
            color: var(--text-main);
            text-transform: uppercase;
        }

        /* Movie Grid Layout */
        .movie-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); 
            gap: 18px; 
            margin-bottom: 40px;
        }

        .movie-card { 
            background: var(--bg-card); 
            border-radius: 12px; 
            overflow: hidden; 
            text-decoration: none; 
            color: var(--text-main); 
            transition: transform 0.2s, box-shadow 0.2s;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--border-color);
            position: relative;
        }

        .movie-card:hover { 
            transform: translateY(-5px); 
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        /* Poster Wrapper */
        .poster-wrapper {
            position: relative;
            width: 100%;
            height: 270px;
            background: #0a0e17;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .poster-wrapper img { 
            width: 100%; 
            height: 100%; 
            object-fit: cover; 
            display: block; 
        }

        .play-placeholder {
            font-size: 40px;
            color: #ffffff;
            opacity: 0.8;
        }

        .views-badge {
            position: absolute;
            bottom: 8px;
            right: 10px;
            background: rgba(0, 0, 0, 0.7);
            padding: 2px 8px;
            border-radius: 10px;
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .pin-badge {
            position: absolute;
            top: 8px;
            left: 8px;
            background: #f59e0b;
            color: #000;
            font-size: 10px;
            font-weight: bold;
            padding: 3px 7px;
            border-radius: 4px;
            z-index: 5;
        }

        .movie-card .info { 
            padding: 14px 10px; 
            font-size: 13px; 
            font-weight: 700;
            text-align: center;
            background: var(--bg-card);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Pagination Bar */
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-bottom: 50px;
            flex-wrap: wrap;
        }

        .page-btn {
            background: var(--bg-card);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            padding: 8px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 13px;
            font-weight: bold;
            transition: all 0.2s;
        }

        .page-btn:hover, .page-btn.active { 
            background: var(--accent-color); 
            border-color: var(--accent-color); 
            color: #fff; 
        }

        /* Footer */
        .footer {
            background: var(--bg-header);
            padding: 20px 0;
            text-align: center;
            border-top: 1px solid var(--border-color);
            color: var(--text-sub);
            font-size: 13px;
        }
    </style>
</head>
<body>

<div class="main-wrapper">
    <div class="container">
        
        <!-- Header -->
        <div class="header">
            <a href="/" class="logo">MOVIE<span>HOUSE</span></a>
            <button class="theme-toggle" id="themeToggleBtn" aria-label="Toggle Theme">☀️</button>
        </div>

        <!-- Search Bar -->
        <div class="search-container">
            <form action="/" method="GET" class="search-box">
                <input type="text" name="search" class="search-input" placeholder="Search movies..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                <button type="submit" class="search-btn">Search</button>
            </form>
        </div>

        <% const activeCat = typeof selectedCategory !== 'undefined' ? selectedCategory : null; %>
        
        <!-- Category Navigation Pill Bar -->
        <div class="category-nav">
            <a href="/" class="cat-btn <%= !activeCat ? 'active' : '' %>">All Movies</a>
            <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                    <a href="/category/<%= encodeURIComponent(cat) %>" class="cat-btn <%= activeCat === cat ? 'active' : '' %>"><%= cat %></a>
                <% }) %>
            <% } %>
        </div>

        <!-- RECENTLY UPDATED SECTION -->
        <h2 class="section-title">
            <% if (searchQuery) { %> SEARCH RESULTS <% } else if (activeCat) { %> <%= activeCat %> MOVIES <% } else { %> RECENTLY UPDATED <% } %>
        </h2>

        <div class="movie-grid">
            <% if (movies && movies.length > 0) { %>
                <% movies.forEach(movie => { %>
                    <a href="/movie/<%= movie._id %>" class="movie-card">
                        <% if (movie.isPinned) { %> <span class="pin-badge">📌 PINNED</span> <% } %>
                        <div class="poster-wrapper">
                            <% if(movie.poster) { %>
                                <img src="<%= movie.poster %>" alt="<%= movie.title %>" onerror="this.src='https://via.placeholder.com/300x450?text=No+Poster'">
                            <% } else { %>
                                <div class="play-placeholder">▶</div>
                            <% } %>
                            <span class="views-badge">👁 <%= movie.views || 0 %></span>
                        </div>
                        <div class="info"><%= movie.title %></div>
                    </a>
                <% }) %>
            <% } else { %>
                <p style="grid-column: 1/-1; text-align: center; color: var(--text-sub); padding: 30px 0;">No movies found.</p>
            <% } %>
        </div>

        <!-- Pagination Bar -->
        <% if (totalPages > 1) { %>
            <% 
                let queryParam = '';
                if (searchQuery) queryParam = '&search=' + encodeURIComponent(searchQuery);
                const baseUrl = activeCat ? '/category/' + encodeURIComponent(activeCat) : '/';
            %>
            <div class="pagination">
                <% if (currentPage > 1) { %>
                    <a href="<%= baseUrl %>?page=<%= currentPage - 1 %><%= queryParam %>" class="page-btn">« Prev</a>
                <% } %>
                
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="<%= baseUrl %>?page=<%= i %><%= queryParam %>" class="page-btn <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
                <% } %>
                
                <% if (currentPage < totalPages) { %>
                    <a href="<%= baseUrl %>?page=<%= currentPage + 1 %><%= queryParam %>" class="page-btn">Next »</a>
                <% } %>
            </div>
        <% } %>

        <!-- POPULAR MOVIES SECTION -->
        <% if (!activeCat && !searchQuery && popularMovies && popularMovies.length > 0) { %>
            <h2 class="section-title">POPULAR MOVIES</h2>
            <div class="movie-grid">
                <% popularMovies.forEach(movie => { %>
                    <a href="/movie/<%= movie._id %>" class="movie-card">
                        <% if (movie.isPinned) { %> <span class="pin-badge">📌 PINNED</span> <% } %>
                        <div class="poster-wrapper">
                            <% if(movie.poster) { %>
                                <img src="<%= movie.poster %>" alt="<%= movie.title %>" onerror="this.src='https://via.placeholder.com/300x450?text=No+Poster'">
                            <% } else { %>
                                <div class="play-placeholder">▶</div>
                            <% } %>
                            <span class="views-badge">👁 <%= movie.views || 0 %></span>
                        </div>
                        <div class="info"><%= movie.title %></div>
                    </a>
                <% }) %>
            </div>
        <% } %>

    </div>
</div>

<!-- Footer -->
<footer class="footer">
    <p>© MOVIEHOUSE - All Rights Reserved</p>
</footer>

<!-- Dark/Light Mode JavaScript -->
<script>
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    
    const currentTheme = localStorage.getItem('theme');
    if (currentTheme === 'light') {
        document.body.classList.add('light-mode');
        themeToggleBtn.textContent = '🌙';
    } else {
        themeToggleBtn.textContent = '☀️';
    }

    themeToggleBtn.addEventListener('click', () => {
        document.body.classList.toggle('light-mode');
        
        if (document.body.classList.contains('light-mode')) {
            localStorage.setItem('theme', 'light');
            themeToggleBtn.textContent = '🌙';
        } else {
            localStorage.setItem('theme', 'dark');
            themeToggleBtn.textContent = '☀️';
        }
    });
</script>

</body>
</html>
