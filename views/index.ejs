<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Movie Streaming</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
            background: #0b0f17; 
            color: #ffffff; 
            padding: 20px 15px; 
        }

        .container { max-width: 1100px; margin: 0 auto; }

        /* Top Category Pill Buttons */
        .category-nav {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        .cat-btn {
            background: #151c28;
            color: #94a3b8;
            padding: 8px 20px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            border: 1px solid #1e293b;
            transition: all 0.2s ease;
        }

        .cat-btn:hover, .cat-btn.active {
            background: #00bcd4;
            color: #ffffff;
            border-color: #00bcd4;
        }

        /* Section Title */
        .section-title {
            text-align: center;
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 25px;
            color: #ffffff;
            text-transform: uppercase;
        }

        /* Movie Grid Layout */
        .movie-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); 
            gap: 18px; 
        }

        .movie-card { 
            background: #151c28; 
            border-radius: 10px; 
            overflow: hidden; 
            text-decoration: none; 
            color: #fff; 
            transition: transform 0.2s, box-shadow 0.2s;
            display: flex;
            flex-direction: column;
            border: 1px solid #1e293b;
        }

        .movie-card:hover { 
            transform: translateY(-4px); 
            box-shadow: 0 8px 20px rgba(0,0,0,0.4);
        }

        /* Image Wrapper with Relative Positioning for Badges */
        .poster-wrapper {
            position: relative;
            width: 100%;
            height: 250px;
            background: #0d131d;
        }

        .poster-wrapper img { 
            width: 100%; 
            height: 100%; 
            object-fit: cover; 
            display: block; 
        }

        /* Pinned Badge (Orange/Gold Pill) */
        .pinned-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: #ff9800;
            color: #000;
            font-size: 10px;
            font-weight: 900;
            padding: 3px 8px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 3px;
            text-transform: uppercase;
        }

        /* Views Badge (Bottom Right Overlay) */
        .views-badge {
            position: absolute;
            bottom: 8px;
            right: 10px;
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
        }

        .movie-card .info { 
            padding: 12px; 
            font-size: 14px; 
            font-weight: 600;
            text-align: center;
            background: #151c28;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Pagination Style (1 2 3 Buttons) */
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-top: 40px;
            flex-wrap: wrap;
        }

        .page-btn {
            background: #151c28;
            color: #ffffff;
            border: 1px solid #1e293b;
            padding: 8px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 14px;
            font-weight: bold;
            transition: all 0.2s;
        }

        .page-btn:hover { 
            background: #00bcd4; 
            border-color: #00bcd4; 
            color: #fff; 
        }

        .page-btn.active { 
            background: #00bcd4; 
            border-color: #00bcd4; 
            color: #fff; 
            pointer-events: none; 
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Centered Category Buttons -->
    <div class="category-nav">
        <a href="/" class="cat-btn <%= !selectedCategory ? 'active' : '' %>">All Movies</a>
        <a href="/category/Natok" class="cat-btn <%= selectedCategory === 'Natok' ? 'active' : '' %>">Natok</a>
        <a href="/category/Movie" class="cat-btn <%= selectedCategory === 'Movie' ? 'active' : '' %>">Movie</a>
        <a href="/category/Web Series" class="cat-btn <%= selectedCategory === 'Web Series' ? 'active' : '' %>">Web Series</a>
    </div>

    <h2 class="section-title">RECENTLY UPDATED</h2>

    <!-- Movie Card Grid -->
    <div class="movie-grid">
        <% if (movies && movies.length > 0) { %>
            <% movies.forEach(movie => { %>
                <a href="/movie/<%= movie._id %>" class="movie-card">
                    <div class="poster-wrapper">
                        <img src="<%= movie.poster %>" alt="<%= movie.title %>">
                        
                        <% if (movie.isPinned) { %>
                            <span class="pinned-badge">📌 PINNED</span>
                        <% } %>

                        <span class="views-badge">
                            👁 <%= movie.views || 0 %>
                        </span>
                    </div>
                    <div class="info"><%= movie.title %></div>
                </a>
            <% }) %>
        <% } else { %>
            <p style="grid-column: 1/-1; text-align: center; color: #64748b;">No content found.</p>
        <% } %>
    </div>

    <!-- Pagination Controls (1 2 3) -->
    <% if (totalPages > 1) { %>
        <div class="pagination">
            <% if (currentPage > 1) { %>
                <a href="/?page=<%= currentPage - 1 %>" class="page-btn">« Prev</a>
            <% } %>

            <% for(let i = 1; i <= totalPages; i++) { %>
                <a href="/?page=<%= i %>" class="page-btn <%= currentPage === i ? 'active' : '' %>">
                    <%= i %>
                </a>
            <% } %>

            <% if (currentPage < totalPages) { %>
                <a href="/?page=<%= currentPage + 1 %>" class="page-btn">Next »</a>
            <% } %>
        </div>
    <% } %>
</div>

</body>
</html>
