<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - Movie House</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: #090d16; 
            color: #ffffff; 
            padding: 40px 15px;
        }

        .admin-container {
            max-width: 800px;
            margin: 0 auto 30px auto;
            background: #121926;
            padding: 30px;
            border-radius: 12px;
            border: 1px solid #1e293b;
        }

        h2, h3 { text-align: center; margin-bottom: 25px; color: #00bcd4; }
        h3 { text-align: left; margin-bottom: 15px; }

        .form-group { margin-bottom: 18px; }
        label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px; color: #94a3b8; }
        
        input[type="text"], select {
            width: 100%;
            padding: 10px 14px;
            background: #0b0f17;
            border: 1px solid #1e293b;
            border-radius: 6px;
            color: #fff;
            font-size: 14px;
            outline: none;
        }

        input[type="text"]:focus, select:focus {
            border-color: #00bcd4;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 10px;
        }

        .checkbox-group input { width: 18px; height: 18px; cursor: pointer; }

        .btn-submit {
            width: 100%;
            background: #00bcd4;
            color: #fff;
            padding: 12px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 15px;
            transition: background 0.2s;
        }

        .btn-submit:hover { background: #00acc1; }
        
        .btn-cancel {
            display: block;
            text-align: center;
            background: #334155;
            color: #fff;
            padding: 10px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 14px;
            margin-top: 10px;
        }

        .back-link { display: block; text-align: center; margin-top: 15px; color: #94a3b8; text-decoration: none; font-size: 13px; }

        /* List Table Styling */
        .table-responsive { overflow-x: auto; margin-top: 15px; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th, td { padding: 12px 10px; border-bottom: 1px solid #1e293b; font-size: 14px; }
        th { color: #94a3b8; background: #0b0f17; }
        
        .thumb { width: 40px; height: 55px; object-fit: cover; border-radius: 4px; }
        
        .action-btns { display: flex; gap: 8px; }
        
        .btn-edit {
            background: #eab308;
            color: #000;
            padding: 6px 10px;
            border-radius: 4px;
            text-decoration: none;
            font-size: 12px;
            font-weight: bold;
        }

        .btn-delete {
            background: #ef4444;
            color: #fff;
            border: none;
            padding: 6px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
        }
    </style>
</head>
<body>

<% const isEditing = typeof editMovie !== 'undefined' && editMovie !== null; %>

<div class="admin-container">
    <h2><%= isEditing ? 'Edit Content' : 'Add New Movie / Content' %></h2>
    
    <form action="<%= isEditing ? '/admin/update/' + editMovie._id : '/admin/add' %>" method="POST">
        
        <div class="form-group">
            <label>Title</label>
            <input type="text" name="title" value="<%= isEditing ? editMovie.title : '' %>" placeholder="Movie or Series Title" required>
        </div>

        <div class="form-group">
            <label>Poster Image URL</label>
            <input type="text" name="poster" value="<%= isEditing ? editMovie.poster : '' %>" placeholder="https://example.com/poster.jpg" required>
        </div>

        <div class="form-group">
            <label>Category</label>
            <select name="category" required>
                <% const cats = ['Bangladeshi', 'Kolkata Bangla', 'Hindi', 'Tamil', 'English', 'MCU', 'MCU WEB', 'DCU', 'Web Series', 'Natok']; %>
                <% cats.forEach(cat => { %>
                    <option value="<%= cat %>" <%= isEditing && editMovie.category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
            </select>
        </div>

        <div class="form-group">
            <label>Content Type</label>
            <select name="contentType">
                <option value="movie" <%= isEditing && editMovie.contentType === 'movie' ? 'selected' : '' %>>Movie</option>
                <option value="series" <%= isEditing && editMovie.contentType === 'series' ? 'selected' : '' %>>Web Series</option>
            </select>
        </div>

        <div class="form-group checkbox-group">
            <input type="checkbox" name="isPinned" id="isPinned" <%= isEditing && editMovie.isPinned ? 'checked' : '' %>>
            <label for="isPinned" style="margin: 0; cursor: pointer;">Pin to Top / Highlight</label>
        </div>

        <button type="submit" class="btn-submit"><%= isEditing ? 'Update Content' : 'Add Content' %></button>
        <% if (isEditing) { %>
            <a href="/admin" class="btn-cancel">Cancel Edit</a>
        <% } %>
    </form>
    
    <a href="/" class="back-link">← Back to Homepage</a>
</div>

<!-- Manage Content List Table -->
<div class="admin-container">
    <h3>Manage Existing Content (<%= typeof movies !== 'undefined' ? movies.length : 0 %>)</h3>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Poster</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof movies !== 'undefined' && movies.length > 0) { %>
                    <% movies.forEach(movie => { %>
                        <tr>
                            <td><img src="<%= movie.poster %>" class="thumb" alt=""></td>
                            <td><b><%= movie.title %></b> <%= movie.isPinned ? '📌' : '' %></td>
                            <td><%= movie.category %></td>
                            <td>
                                <div class="action-btns">
                                    <a href="/admin?edit=<%= movie._id %>" class="btn-edit">Edit</a>
                                    <form action="/admin/delete/<%= movie._id %>" method="POST" onsubmit="return confirm('Delete this movie?')">
                                        <button type="submit" class="btn-delete">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="text-align: center; color: #94a3b8;">No content added yet.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

</body>
</html>
