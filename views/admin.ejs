<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - Add Movie</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: #090d16; 
            color: #ffffff; 
            padding: 40px 15px;
        }

        .admin-container {
            max-width: 600px;
            margin: 0 auto;
            background: #121926;
            padding: 30px;
            border-radius: 12px;
            border: 1px solid #1e293b;
        }

        h2 { text-align: center; margin-bottom: 25px; color: #00bcd4; }

        .form-group { margin-bottom: 18px; }
        label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px; color: #94a3b8; }
        
        input[type="text"], select {
            width: 100%;
            padding: 10px 14px;
            background: #0b0f17;
            border: 1px solid #1e293b;
            border-radius: 6px;
            color: #fff;
            font-size: 14px;
            outline: none;
        }

        input[type="text"]:focus, select:focus {
            border-color: #00bcd4;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 10px;
        }

        .checkbox-group input { width: 18px; height: 18px; cursor: pointer; }

        .btn-submit {
            width: 100%;
            background: #00bcd4;
            color: #fff;
            padding: 12px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 15px;
            transition: background 0.2s;
        }

        .btn-submit:hover { background: #00acc1; }
        .back-link { display: block; text-align: center; margin-top: 15px; color: #94a3b8; text-decoration: none; font-size: 13px; }
    </style>
</head>
<body>

<div class="admin-container">
    <h2>Add New Movie / Content</h2>
    <form action="/admin/add" method="POST">
        
        <div class="form-group">
            <label>Title</label>
            <input type="text" name="title" placeholder="Movie or Series Title" required>
        </div>

        <div class="form-group">
            <label>Poster Image URL</label>
            <input type="text" name="poster" placeholder="https://example.com/poster.jpg" required>
        </div>

        <div class="form-group">
            <label>Category</label>
            <select name="category" required>
                <option value="Bangladeshi">Bangladeshi</option>
                <option value="Kolkata Bangla">Kolkata Bangla</option>
                <option value="Hindi">Hindi</option>
                <option value="Tamil">Tamil</option>
                <option value="English">English</option>
                <option value="MCU">MCU</option>
                <option value="MCU WEB">MCU WEB</option>
                <option value="DCU">DCU</option>
                <option value="Web Series">Web Series</option>
                <option value="Natok">Natok</option>
            </select>
        </div>

        <div class="form-group">
            <label>Content Type</label>
            <select name="contentType">
                <option value="movie">Movie</option>
                <option value="series">Web Series</option>
            </select>
        </div>

        <div class="form-group checkbox-group">
            <input type="checkbox" name="isPinned" id="isPinned">
            <label for="isPinned" style="margin: 0; cursor: pointer;">Pin to Top / Highlight</label>
        </div>

        <button type="submit" class="btn-submit">Add Content</button>
    </form>
    
    <a href="/" class="back-link">← Back to Homepage</a>
</div>

</body>
</html>
