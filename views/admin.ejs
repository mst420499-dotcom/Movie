<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MOVIEHOUSE - Single Admin Panel</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: #090d16; 
            color: #ffffff; 
            padding: 30px 15px;
        }

        .container { max-width: 1000px; margin: 0 auto; }
        
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid #1e293b;
        }

        .logo { font-size: 24px; font-weight: 900; color: #00bcd4; text-decoration: none; }
        .back-btn { color: #94a3b8; text-decoration: none; font-size: 14px; }
        .back-btn:hover { color: #fff; }

        /* Form Card */
        .card {
            background: #121926;
            padding: 25px;
            border-radius: 12px;
            border: 1px solid #1e293b;
            margin-bottom: 40px;
        }

        .card h3 { margin-bottom: 20px; color: #00bcd4; font-size: 18px; }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
        }

        .form-group { margin-bottom: 15px; }
        label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #94a3b8; }

        input[type="text"], select {
            width: 100%;
            padding: 10px 14px;
            background: #090d16;
            border: 1px solid #1e293b;
            border-radius: 6px;
            color: #fff;
            font-size: 14px;
            outline: none;
        }

        input[type="text"]:focus, select:focus { border-color: #00bcd4; }

        .checkbox-group { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
        .checkbox-group input { width: 16px; height: 16px; cursor: pointer; }

        .btn-submit {
            background: #00bcd4;
            color: #fff;
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            transition: background 0.2s;
        }

        .btn-submit:hover { background: #00acc1; }

        /* Table Style */
        .table-responsive { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th, td { padding: 12px 15px; border-bottom: 1px solid #1e293b; font-size: 14px; }
        th { background: #121926; color: #94a3b8; font-weight: 700; }
        
        .thumb { width: 45px; height: 60px; object-fit: cover; border-radius: 4px; }
        
        .btn-delete {
            background: #ef4444;
            color: #fff;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
        }

        .btn-delete:hover { background: #dc2626; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <a href="/" class="logo">MOVIEHOUSE ADMIN</a>
        <a href="/" class="back-btn">← Back to Site</a>
    </div>

    <!-- Add Content Form -->
    <div class="card">
        <h3>Add New Content</h3>
        <form action="/admin/add" method="POST">
            <div class="form-grid">
                <div class="form-group">
                    <label>Title</label>
                    <input type="text" name="title" placeholder="Movie / Series Title" required>
                </div>
                <div class="form-group">
                    <label>Poster Image URL</label>
                    <input type="text" name="poster" placeholder="https://..." required>
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select name="category" required>
                        <option value="Bangladeshi">Bangladeshi</option>
                        <option value="Kolkata Bangla">Kolkata Bangla</option>
                        <option value="Hindi">Hindi</option>
                        <option value="Tamil">Tamil</option>
                        <option value="English">English</option>
                        <option value="MCU">MCU</option>
                        <option value="MCU WEB">MCU WEB</option>
                        <option value="DCU">DCU</option>
                        <option value="Web Series">Web Series</option>
                        <option value="Natok">Natok</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Content Type</label>
                    <select name="contentType">
                        <option value="movie">Movie</option>
                        <option value="series">Web Series</option>
                    </select>
                </div>
            </div>

            <div class="checkbox-group">
                <input type="checkbox" name="isPinned" id="isPinned">
                <label for="isPinned" style="margin:0; cursor:pointer;">Pin/Highlight Content</label>
            </div>

            <button type="submit" class="btn-submit">Add Content</button>
        </form>
    </div>

    <!-- Manage Movies List -->
    <div class="card">
        <h3>All Manage Content (<%= movies.length %>)</h3>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Poster</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Views</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (movies && movies.length > 0) { %>
                        <% movies.forEach(movie => { %>
                            <tr>
                                <td><img src="<%= movie.poster %>" class="thumb" alt=""></td>
                                <td><b><%= movie.title %></b></td>
                                <td><%= movie.category %></td>
                                <td>👁 <%= movie.views %></td>
                                <td>
                                    <form action="/admin/delete/<%= movie._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this?')">
                                        <button type="submit" class="btn-delete">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center; color: #94a3b8;">No content added yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

</body>
</html>
