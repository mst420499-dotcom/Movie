const express = require('express');
const router = express.Router();
const multer = require('multer');
const path = require('path');

// Multer Setup for Image Uploads
const storage = multer.diskStorage({
    destination: (req, file, cb) => cb(null, 'public/uploads/'),
    filename: (req, file, cb) => cb(null, Date.now() + path.extname(file.originalname))
});
const upload = multer({ storage });

// Dummy Data Arrays (Database-এর সাথে এটি রিপ্লেস করতে পারেন)
let categories = ['Action', 'Drama', 'Comedy', 'Thriller'];
let movies = [];

// 1. GET Admin Page
router.get('/admin', (req, res) => {
    const editId = req.query.edit;
    let movieToEdit = null;

    if (editId) {
        movieToEdit = movies.find(m => m.id === editId);
    }

    res.render('admin', {
        categories,
        movies,
        movieToEdit,
        msg: req.query.msg || null,
        err: req.query.err || null
    });
});

// 2. POST Save / Edit Movie or Series
router.post('/admin/save-movie', upload.single('posterFile'), (req, res) => {
    const { id, title, contentType, category, posterUrl, isPinned } = req.body;

    // Determine poster path
    let poster = posterUrl;
    if (req.file) {
        poster = `/uploads/${req.file.filename}`;
    }

    // Process Video Links for Single Movies
    let videoLinks = [];
    if (contentType === 'movie' && req.body['linkName[]']) {
        const names = Array.isArray(req.body['linkName[]']) ? req.body['linkName[]'] : [req.body['linkName[]']];
        const urls = Array.isArray(req.body['linkUrl[]']) ? req.body['linkUrl[]'] : [req.body['linkUrl[]']];
        videoLinks = names.map((name, i) => ({ name, url: urls[i] }));
    }

    // Process Episodes for Web Series
    let episodes = [];
    if (contentType === 'series' && req.body['epName[]']) {
        const seasons = Array.isArray(req.body['epSeason[]']) ? req.body['epSeason[]'] : [req.body['epSeason[]']];
        const nums = Array.isArray(req.body['epNum[]']) ? req.body['epNum[]'] : [req.body['epNum[]']];
        const names = Array.isArray(req.body['epName[]']) ? req.body['epName[]'] : [req.body['epName[]']];
        const urls = Array.isArray(req.body['epUrl[]']) ? req.body['epUrl[]'] : [req.body['epUrl[]']];

        episodes = names.map((name, i) => ({
            season: seasons[i],
            episodeNumber: nums[i],
            name,
            url: urls[i]
        }));
    }

    const movieData = {
        id: id || Date.now().toString(),
        title,
        contentType,
        category,
        poster: poster || '/placeholder.jpg',
        videoLinks,
        episodes,
        isPinned: isPinned === 'on'
    };

    if (id) {
        // Update Existing Item
        const index = movies.findIndex(m => m.id === id);
        if (index !== -1) movies[index] = movieData;
    } else {
        // Add New Item
        movies.push(movieData);
    }

    res.redirect('/admin?msg=Content Saved Successfully!');
});

// 3. POST Toggle Pin Status
router.post('/admin/toggle-pin/:id', (req, res) => {
    const movie = movies.find(m => m.id === req.params.id);
    if (movie) {
        movie.isPinned = !movie.isPinned;
    }
    res.redirect('/admin');
});

// 4. POST Delete Movie
router.post('/admin/delete-movie/:id', (req, res) => {
    movies = movies.filter(m => m.id !== req.params.id);
    res.redirect('/admin?msg=Content Deleted!');
});

// 5. POST Add Category
router.post('/admin/add-category', (req, res) => {
    const { categoryName } = req.body;
    if (categoryName && !categories.includes(categoryName)) {
        categories.push(categoryName);
    }
    res.redirect('/admin?msg=Category Added!');
});

// 6. POST Delete Category
router.post('/admin/delete-category', (req, res) => {
    const { categoryName } = req.body;
    categories = categories.filter(c => c !== categoryName);
    res.redirect('/admin?msg=Category Deleted!');
});

module.exports = router;
