<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - MOVIEHOUSE</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: #090d16; 
            color: #ffffff; 
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .login-card {
            background: #121926;
            padding: 30px;
            border-radius: 12px;
            border: 1px solid #1e293b;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }
        h2 { text-align: center; margin-bottom: 20px; font-size: 22px; color: #00bcd4; }
        .form-group { margin-bottom: 15px; }
        label { display: block; font-size: 13px; margin-bottom: 5px; color: #94a3b8; }
        input {
            width: 100%;
            background: #090d16;
            border: 1px solid #1e293b;
            padding: 10px 15px;
            border-radius: 6px;
            color: #fff;
            outline: none;
            font-size: 14px;
        }
        input:focus { border-color: #00bcd4; }
        .btn {
            width: 100%;
            background: #00bcd4;
            color: #fff;
            border: none;
            padding: 10px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            transition: background 0.2s;
        }
        .btn:hover { background: #00acc1; }
        .error-msg { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); padding: 8px; border-radius: 6px; font-size: 13px; text-align: center; margin-bottom: 15px; }
    </style>
</head>
<body>

<div class="login-card">
    <h2>Admin Login</h2>
    <% if (typeof err !== 'undefined' && err) { %>
        <div class="error-msg"><%= err %></div>
    <% } %>
    <form action="/admin/login" method="POST">
        <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" placeholder="Enter password (default: admin)" required>
        </div>
        <button type="submit" class="btn">Login</button>
    </form>
</div>

</body>
</html>
